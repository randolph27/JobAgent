{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/workflow-bootstrap/profile.schema.json",
  "title": "Workflow Bootstrap profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "display_name",
    "description",
    "source",
    "default_config",
    "function_catalog",
    "command_catalog",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "workflow-bootstrap-profile/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "git_commit", "captured_utc", "entrypoint_sha256"],
      "properties": {
        "project_root": {
          "type": "string"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "captured_utc": {
          "type": "string",
          "format": "date-time"
        },
        "entrypoint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_config": {
      "type": "string"
    },
    "function_catalog": {
      "type": "string"
    },
    "command_catalog": {
      "type": "string"
    },
    "payload": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "destination", "sha256", "size", "role"],
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": ["profile-entrypoint", "profile-module", "profile-helper"]
          }
        }
      }
    }
  }
}
