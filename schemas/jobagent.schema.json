    "scan_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_class",
        "message"
      ],
      "properties": {
        "error_class": {
          "$ref": "#/$defs/scan_attempt/properties/error_class"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "job_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "job_id",
        "scan_run_id",
        "source_id",
        "captured_at",
        "content_hash",
        "status",
        "title",
        "location",
        "official_url",
        "summary"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "scan_run_id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "captured_at": {
          "$ref": "#/$defs/date_time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "$ref": "#/$defs/job_status"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "official_url": {
          "$ref": "#/$defs/uri"
        },
        "summary": {
          "$ref": "#/$defs/unknownable_string"
        },
        "description": {
          "$ref": "#/$defs/unknownable_string"
        }
      }
    },
    "change_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_event_id",
        "job_id",
        "scan_run_id",
        "event_type",
        "created_at",
        "old_status",
        "new_status",
        "changed_fields",
        "reason"
      ],
      "properties": {
        "change_event_id": {
          "$ref": "#/$defs/id"
        },
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "scan_run_id": {
          "$ref": "#/$defs/id"
        },
        "event_type": {
          "enum": [
            "JOB_CREATED",
            "JOB_UPDATED",
            "JOB_CLOSED",
            "JOB_REMOVED",
            "JOB_INVALIDATED"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        },
        "old_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/job_status"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_status": {
          "$ref": "#/$defs/job_status"
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
