{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/jobagent/jobagent.schema.json",
  "title": "JobAgent domain data v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "companies",
    "jobs",
    "job_sources",
    "scan_runs",
    "scan_attempts",
    "job_snapshots",
    "change_events"
  ],
  "properties": {
    "schema_version": {
      "const": "jobagent/v1"
    },
    "generated_at": {
      "$ref": "#/$defs/date_time"
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "job_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job_source"
      }
    },
    "scan_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scan_run"
      }
    },
    "scan_attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scan_attempt"
      }
    },
    "job_snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job_snapshot"
      }
    },
    "change_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change_event"
      }
    }
  },
  "$defs": {
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "minLength": 8
    },
    "unknownable_string": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "job_status": {
      "enum": [
        "NEW",
        "ACTIVE",
        "UPDATED",
        "CLOSED",
        "REMOVED",
        "INVALID"
      ]
    },
    "scan_status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCESS",
        "PARTIAL",
        "FAILED",
        "SKIPPED"
      ]
    },
    "source_type": {
      "enum": [
        "COMPANY_WEBSITE",
        "CAREER_PAGE",
        "OFFICIAL_ATS",
        "JOB_DETAIL"
      ]
    },
    "discovery_registry_source_class": {
      "enum": [
        "OFFICIAL_REGISTER",
        "OPEN_REGISTER_DUMP",
        "REGIONAL_DIRECTORY",
        "PUBLIC_INSTITUTION_DIRECTORY",
        "JOB_BOARD_DISCOVERY",
        "OFFICIAL_COMPANY",
        "OFFICIAL_ATS",
        "MANUAL_REVIEW",
        "REJECTED"
      ]
    },
    "discovery_registry_evidence_level": {
      "enum": [
        "PRIMARY_OFFICIAL",
        "SECONDARY_OFFICIAL_DIRECTORY",
        "DISCOVERY_HINT",
        "MANUAL_REVIEW_ONLY",
        "NOT_IMPORTABLE"
      ]
    },
    "verification_evidence_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "REJECTED"
      ]
    },
    "verification_evidence_type": {
      "enum": [
        "COMPANY_DOMAIN",
        "CAREER_URL",
        "ATS_VERIFIED_BY_URL",
        "COMPANY_LINKED_ATS",
        "AGGREGATOR_REJECTED",
        "UNVERIFIED"
      ]
    },
    "priority": {
      "enum": [
        "A",
        "B",
        "C",
        "UNRATED"
      ]
    },
    "classification_result": {
      "enum": [
        "MATCH",
        "POSSIBLE",
        "REJECTED",
        "UNKNOWN"
      ]
    },
    "work_model": {
      "enum": [
        "ON_SITE",
        "HYBRID",
        "REMOTE",
        "UNKNOWN"
      ]
    },
    "employment_type": {
      "enum": [
        "FULL_TIME",
        "PART_TIME",
        "CONTRACT",
        "TEMPORARY",
        "UNKNOWN"
      ]
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "canonical_name",
        "canonical_domain",
        "official_website_url",
        "career_url",
        "aliases",
        "locations",
        "industry",
        "ats",
        "scan_status",
        "scan_priority",
        "next_scan_at",
        "verification_status",
        "discovery_source",
        "created_at",
        "updated_at",
        "last_successful_scan_at"
      ],
      "properties": {
        "company_id": {
          "$ref": "#/$defs/id"
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "canonical_domain": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
        },
        "official_website_url": {
          "$ref": "#/$defs/uri"
        },
        "career_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "industry": {
          "$ref": "#/$defs/unknownable_string"
        },
        "ats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ats_binding"
          }
        },
        "scan_status": {
          "$ref": "#/$defs/scan_status"
        },
        "scan_priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "next_scan_at": {
          "$ref": "#/$defs/date_time"
        },
        "verification_status": {
          "enum": [
            "COMPANY_DOMAIN_VERIFIED",
            "CAREER_URL_VERIFIED",
            "UNVERIFIED"
          ]
        },
        "discovery_source": {
          "$ref": "#/$defs/company_discovery_source"
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        },
        "updated_at": {
          "$ref": "#/$defs/date_time"
        },
        "last_successful_scan_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/date_time"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_cluster_id": {
          "$ref": "#/$defs/id"
        },
        "dedupe_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conflict_flags": {
          "type": "array",
          "items": {
            "enum": [
              "NAME_MATCH_WITHOUT_STRONG_IDENTITY",
              "STAFFING_AGENCY_REVIEW",
              "TARGET_AREA_UNCERTAIN",
              "OUT_OF_SCOPE_HINT"
            ]
          },
          "uniqueItems": true
        },
        "target_area_basis": {
          "type": "array",
          "items": {
            "enum": [
              "REGISTER_SEAT_IN_TARGET",
              "JOB_LOCATION_IN_TARGET",
              "BRANCH_HINT_IN_TARGET",
              "REMOTE_WITH_TARGET_REFERENCE",
              "TARGET_UNCERTAIN",
              "OUT_OF_SCOPE"
            ]
          },
          "uniqueItems": true
        },
        "source_count": {
          "type": "integer",
          "minimum": 1
        },
        "first_seen_at": {
          "$ref": "#/$defs/date_time"
        },
        "last_seen_at": {
          "$ref": "#/$defs/date_time"
        },
        "review_queue_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "company_discovery_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url",
        "observed_at",
        "verification_url",
        "discovery_origin",
        "target_area",
        "industry_hint",
        "evidence_note"
      ],
      "properties": {
        "type": {
          "enum": [
            "OFFICIAL_WEBSITE",
            "MANUAL_REVIEW",
            "DISCOVERY_HINT"
          ]
        },
        "url": {
          "$ref": "#/$defs/uri"
        },
        "observed_at": {
          "$ref": "#/$defs/date_time"
        },
        "verification_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "discovery_origin": {
          "$ref": "#/$defs/unknownable_string"
        },
        "target_area": {
          "$ref": "#/$defs/location/properties/target_area"
        },
        "industry_hint": {
          "$ref": "#/$defs/unknownable_string"
        },
        "evidence_note": {
          "$ref": "#/$defs/unknownable_string"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "city",
        "region",
        "country",
        "target_area"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/unknownable_string"
        },
        "city": {
          "$ref": "#/$defs/unknownable_string"
        },
        "region": {
          "$ref": "#/$defs/unknownable_string"
        },
        "country": {
          "$ref": "#/$defs/unknownable_string"
        },
        "target_area": {
          "enum": [
            "MUNICH",
            "MUNICH_20KM",
            "FREISING",
            "REMOTE_WITH_TARGET_REFERENCE",
            "UNKNOWN",
            "OUT_OF_SCOPE"
          ]
        }
      }
    },
    "ats_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "official_domain",
        "verified_by_url"
      ],
      "properties": {
        "system": {
          "$ref": "#/$defs/unknownable_string"
        },
        "official_domain": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
        },
        "verified_by_url": {
          "$ref": "#/$defs/uri"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "company_id",
        "official_url",
        "alternative_official_urls",
        "source_id",
        "external_job_id",
        "ats_job_id",
        "title",
        "location",
        "work_model",
        "employment_type",
        "status",
        "first_seen",
        "last_seen",
        "changed_at",
        "classification",
        "priority",
        "requirements",
        "salary",
        "identity_basis"
      ],
      "anyOf": [
        {
          "required": [
            "external_job_id"
          ],
          "properties": {
            "external_job_id": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "UNKNOWN"
              }
            }
          }
        },
        {
          "required": [
            "ats_job_id"
          ],
          "properties": {
            "ats_job_id": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "UNKNOWN"
              }
            }
          }
        },
        {
          "required": [
            "official_url"
          ]
        }
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/id"
        },
        "company_id": {
          "$ref": "#/$defs/id"
        },
        "official_url": {
          "$ref": "#/$defs/uri"
        },
        "alternative_official_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uri"
          },
          "uniqueItems": true
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "external_job_id": {
          "$ref": "#/$defs/unknownable_string"
        },
        "ats_job_id": {
          "$ref": "#/$defs/unknownable_string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "work_model": {
          "$ref": "#/$defs/work_model"
        },
        "employment_type": {
          "$ref": "#/$defs/employment_type"
        },
        "description": {
          "$ref": "#/$defs/unknownable_string"
        },
        "description_source": {
          "enum": [
            "OFFICIAL_SOURCE",
            "NONE"
          ]
        },
        "status": {
          "$ref": "#/$defs/job_status"
        },
        "first_seen": {
          "$ref": "#/$defs/date_time"
        },
        "last_seen": {
          "$ref": "#/$defs/date_time"
        },
        "changed_at": {
          "$ref": "#/$defs/date_time"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknownable_string"
          }
        },
        "salary": {
          "$ref": "#/$defs/unknownable_string"
        },
        "identity_basis": {
          "enum": [
            "OFFICIAL_JOB_ID",
            "ATS_JOB_ID",
            "CANONICAL_URL",
            "COMPOSITE_FINGERPRINT"
          ]
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "priority",
        "score",
        "reasons",
        "rejected_reasons",
        "evaluated_at"
      ],
      "properties": {
        "result": {
          "$ref": "#/$defs/classification_result"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluated_at": {
          "$ref": "#/$defs/date_time"
        }
      }
    },
    "job_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "company_id",
        "source_type",
        "url",
        "canonical_url",
        "is_official",
        "verified_at",
        "verification_basis",
        "verification_evidence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "company_id": {
          "$ref": "#/$defs/id"
        },
        "source_type": {
          "$ref": "#/$defs/source_type"
        },
        "url": {
          "$ref": "#/$defs/uri"
        },
        "canonical_url": {
          "$ref": "#/$defs/uri"
        },
        "is_official": {
          "const": true
        },
        "verified_at": {
          "$ref": "#/$defs/date_time"
        },
        "verification_basis": {
          "enum": [
            "COMPANY_DOMAIN",
            "CAREER_URL",
            "COMPANY_LINKED_ATS",
            "OFFICIAL_JOB_DETAIL"
          ]
        },
        "verification_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verification_evidence"
          }
        }
      }
    },
    "coverage_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_type",
        "label",
        "url",
        "source_id",
        "source_field",
        "verification_status",
        "is_primary",
        "is_clickable",
        "review_only",
        "reason"
      ],
      "properties": {
        "link_type": {
          "enum": [
            "career",
            "website",
            "ats",
            "review_hint",
            "missing"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_field": {
          "enum": [
            "company.career_url",
            "company.official_website_url",
            "company.discovery_source.url",
            "job_sources.canonical_url",
            "coverage.fail_closed"
          ]
        },
        "verification_status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "MISSING"
          ]
        },
        "is_primary": {
          "type": "boolean"
        },
        "is_clickable": {
          "type": "boolean"
        },
        "review_only": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_type",
        "url",
        "basis_url",
        "redirect_chain",
        "observed_at",
        "reason"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/verification_evidence_status"
        },
        "evidence_type": {
          "$ref": "#/$defs/verification_evidence_type"
        },
        "url": {
          "$ref": "#/$defs/uri"
        },
        "basis_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "redirect_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uri"
          },
          "uniqueItems": true
        },
        "observed_at": {
          "$ref": "#/$defs/date_time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scan_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_run_id",
        "started_at",
        "finished_at",
        "status",
        "company_ids",
        "artifact_paths",
        "errors"
      ],
      "properties": {
        "scan_run_id": {
          "$ref": "#/$defs/id"
        },
        "started_at": {
          "$ref": "#/$defs/date_time"
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/date_time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/scan_status"
        },
        "company_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scan_error"
          }
        }
      }
    },
    "scan_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan_attempt_id",
        "scan_run_id",
        "company_id",
        "source_id",
        "started_at",
        "finished_at",
        "status",
        "adapter",
        "error_class",
        "retry_recommendation",
        "http_status"
      ],
      "properties": {
        "scan_attempt_id": {
          "$ref": "#/$defs/id"
        },
        "scan_run_id": {
          "$ref": "#/$defs/id"
        },
        "company_id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "started_at": {
          "$ref": "#/$defs/date_time"
        },
        "finished_at": {
          "$ref": "#/$defs/date_time"
        },
        "status": {
          "$ref": "#/$defs/scan_status"
        },
        "adapter": {
          "$ref": "#/$defs/unknownable_string"
        },
        "error_class": {
          "enum": [
            "NONE",
            "NOT_REACHABLE",
            "TIMEOUT",
            "BLOCKED",
            "NO_JOBS_FOUND",
            "UNCLEAR_SOURCE",
            "PARSING_ERROR",
            "TECHNICAL_LIMITATION"
          ]
        },
        "retry_recommendation": {
          "enum": [
            "NONE",
            "RETRY_SOON",
            "RETRY_NEXT_RUN",
            "MANUAL_REVIEW"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        }
      }
    },
    "adapter_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "company_id",
        "source_id",
        "official_source_url",
        "status",
        "error_class",
        "retry_recommendation",
        "raw_jobs",
        "scan_attempt",
        "artifact_paths"
      ],
      "properties": {
        "adapter": {
          "$ref": "#/$defs/unknownable_string"
        },
        "company_id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "official_source_url": {
          "$ref": "#/$defs/uri"
        },
        "status": {
          "$ref": "#/$defs/scan_status"
        },
        "error_class": {
          "$ref": "#/$defs/scan_attempt/properties/error_class"
        },
        "retry_recommendation": {
          "$ref": "#/$defs/scan_attempt/properties/retry_recommendation"
        },
        "raw_jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/raw_job"
          }
        },
        "scan_attempt": {
          "$ref": "#/$defs/scan_attempt"
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "raw_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "detail_url",
        "external_job_id",
        "ats_job_id",
        "location_label",
        "summary",
        "extraction_confidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail_url": {
          "$ref": "#/$defs/uri"
        },
        "external_job_id": {
          "$ref": "#/$defs/unknownable_string"
        },
        "ats_job_id": {
          "$ref": "#/$defs/unknownable_string"
        },
        "location_label": {
          "$ref": "#/$defs/unknownable_string"
        },
        "summary": {
          "$ref": "#/$defs/unknownable_string"
        },
        "description": {
          "$ref": "#/$defs/unknownable_string"
        },
        "description_source": {
          "enum": [
            "OFFICIAL_SOURCE",
            "NONE"
          ]
        },
        "source_status": {
          "enum": [
            "ACTIVE",
            "OPEN",
            "PUBLISHED",
            "CLOSED",
            "EXPIRED",
            "FILLED"
          ]
        },
        "job_state": {
          "enum": [
            "ACTIVE",
            "OPEN",
            "PUBLISHED",
            "CLOSED",
            "EXPIRED",
            "FILLED"
          ]
        },
        "extraction_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
