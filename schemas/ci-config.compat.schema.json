{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/workflow-bootstrap/ci-config.compat.schema.json",
  "title": "Compatible CI configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "type": "string"
    },
    "workspace_lock": {
      "oneOf": [
        {
          "enum": ["on", "off"]
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "on": {
              "type": "boolean"
            },
            "stale_minutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "enum": ["on", "off", "staged"]
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cmd": {
          "type": ["string", "null"]
        }
      }
    },
    "devserver": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "cmd": {
          "type": ["string", "null"]
        }
      }
    },
    "todo": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "autoseed_from_roadmap": {
          "type": "boolean"
        },
        "seed_max_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
