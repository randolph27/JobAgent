{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/workflow-bootstrap/workflow-event.schema.json",
  "title": "Workflow event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sequence",
    "event_id",
    "ts",
    "type",
    "todo_id",
    "payload",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema": {
      "const": "workflow-event/v2"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}(?:\\.[0-9]{1,7})?Z-[a-f0-9]{12}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "todo.created",
        "todo.updated",
        "todo.status_changed",
        "todo.removed",
        "focus.changed",
        "checkpoint.created",
        "migration.snapshot"
      ]
    },
    "todo_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
    },
    "payload": {
      "type": "object"
    },
    "previous_event_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
