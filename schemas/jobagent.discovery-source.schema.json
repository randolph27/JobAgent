{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/jobagent/jobagent.discovery-source.schema.json",
  "title": "JobAgent discovery source registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "jobagent/discovery-source/v2"
    },
    "generated_at": {
      "$ref": "#/$defs/date_time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/discovery_source"
      }
    }
  },
  "$defs": {
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "minLength": 8
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "source_class": {
      "enum": [
        "OFFICIAL_REGISTER",
        "OPEN_REGISTER_DUMP",
        "REGIONAL_DIRECTORY",
        "PUBLIC_INSTITUTION_DIRECTORY",
        "JOB_BOARD_DISCOVERY",
        "OFFICIAL_COMPANY",
        "OFFICIAL_ATS",
        "MANUAL_REVIEW",
        "REJECTED"
      ]
    },
    "evidence_level": {
      "enum": [
        "PRIMARY_OFFICIAL",
        "SECONDARY_OFFICIAL_DIRECTORY",
        "DISCOVERY_HINT",
        "MANUAL_REVIEW_ONLY",
        "NOT_IMPORTABLE"
      ]
    },
    "import_mode": {
      "enum": [
        "TARGETED_LOOKUP_ONLY",
        "BULK_SNAPSHOT",
        "FIXTURE_OR_SNAPSHOT_ONLY",
        "MANUAL_REVIEW_ONLY",
        "REJECT"
      ]
    },
    "legal_risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "BLOCKED"
      ]
    },
    "discovery_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_class",
        "source_url",
        "operator",
        "allowed_use",
        "forbidden_use",
        "rate_limit_policy",
        "robots_or_terms_note",
        "expected_fields",
        "evidence_level",
        "freshness_policy",
        "retention_policy",
        "import_mode",
        "review_required",
        "legal_risk"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^source-registry:[a-z0-9][a-z0-9._-]*$"
        },
        "source_class": {
          "$ref": "#/$defs/source_class"
        },
        "source_url": {
          "$ref": "#/$defs/uri"
        },
        "operator": {
          "$ref": "#/$defs/non_empty_string"
        },
        "allowed_use": {
          "$ref": "#/$defs/non_empty_string"
        },
        "forbidden_use": {
          "$ref": "#/$defs/non_empty_string"
        },
        "rate_limit_policy": {
          "$ref": "#/$defs/non_empty_string"
        },
        "robots_or_terms_note": {
          "$ref": "#/$defs/non_empty_string"
        },
        "expected_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          },
          "uniqueItems": true
        },
        "evidence_level": {
          "$ref": "#/$defs/evidence_level"
        },
        "freshness_policy": {
          "$ref": "#/$defs/non_empty_string"
        },
        "retention_policy": {
          "$ref": "#/$defs/non_empty_string"
        },
        "import_mode": {
          "$ref": "#/$defs/import_mode"
        },
        "review_required": {
          "type": "boolean"
        },
        "legal_risk": {
          "$ref": "#/$defs/legal_risk"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_class": {
                "enum": [
                  "JOB_BOARD_DISCOVERY",
                  "OPEN_REGISTER_DUMP",
                  "REGIONAL_DIRECTORY",
                  "PUBLIC_INSTITUTION_DIRECTORY",
                  "MANUAL_REVIEW"
                ]
              }
            },
            "required": [
              "source_class"
            ]
          },
          "then": {
            "properties": {
              "review_required": {
                "const": true
              }
            },
            "not": {
              "properties": {
                "evidence_level": {
                  "const": "PRIMARY_OFFICIAL"
                }
              },
              "required": [
                "evidence_level"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_class": {
                "const": "REJECTED"
              }
            },
            "required": [
              "source_class"
            ]
          },
          "then": {
            "properties": {
              "evidence_level": {
                "const": "NOT_IMPORTABLE"
              },
              "import_mode": {
                "const": "REJECT"
              },
              "review_required": {
                "const": true
              },
              "legal_risk": {
                "const": "BLOCKED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_class": {
                "enum": [
                  "OFFICIAL_COMPANY",
                  "OFFICIAL_ATS"
                ]
              }
            },
            "required": [
              "source_class"
            ]
          },
          "then": {
            "properties": {
              "evidence_level": {
                "const": "PRIMARY_OFFICIAL"
              },
              "review_required": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
